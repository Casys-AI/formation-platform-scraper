{
  "name": "formation-platform-scraper",
  "version": "1.0.0",
  "description": "Scraper for Teachizy-hosted formation platforms - full content extraction, media transcription (Whisper), link qualification, and knowledge graph generation",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/cli/cli.ts",
    "scraper": "tsx src/cli/cli.ts",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "discover": "tsx src/cli/cli.ts discover",
    "list-chapters": "tsx src/cli/cli.ts list",
    "select-chapters": "tsx src/cli/cli.ts select",
    "extract": "tsx src/cli/extract.ts",
    "check-links": "tsx src/cli/check-links.ts",
    "kg": "tsx src/cli/knowledge-graph.ts",
    "knowledge-graph": "tsx src/cli/knowledge-graph.ts",
    "dry-run": "tsx src/cli/cli.ts extract dry-run-config.json",
    "report": "tsx src/cli/report.ts",
    "resources": "tsx src/cli/resources.ts",
    "pdf": "pnpm build && node dist/cli/chapter-summary.js",
    "pdf:all": "bash -c 'formation=$1; start=${2:-1}; end=${3:-26}; for i in $(seq $start $end); do echo \"=== Chapter $i PDF ===\"  && pnpm build && node dist/cli/chapter-summary.js $i --pdf --formation=$formation; done' --"
  },
  "keywords": [
    "scraper",
    "formation",
    "teachizy",
    "whisper",
    "playwright"
  ],
  "author": "Casys-AI",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^3.3.0",
    "@langchain/openai": "^0.5.18",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/cheerio": "^1.0.0",
    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "cheerio": "^1.1.2",
    "commander": "^11.x",
    "dotenv": "^16.3.1",
    "execa": "^8.x",
    "figlet": "^1.7.0",
    "gradient-string": "^2.0.2",
    "md-to-pdf": "^5.2.4",
    "openai": "^4.x",
    "ora": "^7.0.1",
    "p-limit": "^7.2.0",
    "pino": "^10.1.0",
    "pino-loki": "^2.6.0",
    "pino-pretty": "^13.1.2",
    "slugify": "^1.6.x",
    "table": "^6.8.1"
  },
  "devDependencies": {
    "@types/figlet": "^1.5.8",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  }
}

# =============================================================================
# Formation access (required)
# The credentials you use to log into the formation, and the formation URL.
# Login happens directly on the school's domain (e.g. formations.example.academy).
# =============================================================================
FORMATION_EMAIL=
FORMATION_PASSWORD=
FORMATION_URL=https://formations.example.academy/mon-espace/formations/my-course

# =============================================================================
# AI services (required)
# =============================================================================
# OpenAI API key - used for Whisper audio transcription and AI content formatting.
OPENAI_API_KEY=

# =============================================================================
# Link qualification (optional)
# Used to summarize/score external links and search for replacements.
# =============================================================================
TAVILY_API_KEY=

# =============================================================================
# Logging (optional)
# =============================================================================
# Log verbosity: debug | info | warn | error (default: info).
LOG_LEVEL=
# Ship logs to a Grafana Loki instance (default: disabled).
LOKI_ENABLED=
LOKI_URL=

# =============================================================================
# Runtime overrides (optional)
# These take precedence over extraction-config.json when set. Everything else
# about extraction behavior (chapters, modes, media/formatting options, rate
# limiting) is configured in extraction-config.json; link checking is
# configured in link-check-config.json.
# =============================================================================
# Run the Playwright browser with a visible window (set to "false" to see it).
PLAYWRIGHT_HEADLESS=
# Delay in ms between page navigations (overrides rateLimit.delayMs).
DELAY_BETWEEN_PAGES_MS=
# Set to "false" to skip downloading media (overrides media.skipMedia).
DOWNLOAD_MEDIA=
# Set to "false" to skip Whisper transcription (overrides media.skipTranscribe).
TRANSCRIBE_MEDIA=
